  const storyModal = document.getElementById('storyModal');
  const modalCloseBtn = document.getElementById('modalCloseBtn');
  const modalImg = document.getElementById('modalImg');
  const modalMeta = document.getElementById('modalMeta');
  const modalTitle = document.getElementById('modalTitle');
  const modalBody = document.getElementById('modalBody');

  function openStoryModal(idx) {
    const story = CHAPTER_STORIES[idx];
    if (!story || !storyModal) return;

    if (modalImg) {
      modalImg.innerHTML = story.image 
        ? `<img src="${story.image}" alt="${story.title}" referrerpolicy="no-referrer">` 
        : '';
    }
    if (modalMeta) {
      modalMeta.textContent = `${story.category} \u2014 ${story.date}`;
    }
    if (modalTitle) {
      modalTitle.textContent = story.title;
    }
    if (modalBody) {
      modalBody.innerHTML = story.paragraphs.map(p => `<p>${p}</p>`).join('');
    }

    storyModal.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeStoryModal() {
    if (!storyModal) return;
    storyModal.classList.remove('open');
    document.body.style.overflow = '';
  }

  document.querySelectorAll('[data-story-idx]').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const idx = parseInt(btn.getAttribute('data-story-idx'), 10);
      openStoryModal(idx);
    });
  });

  if (modalCloseBtn) {
    modalCloseBtn.addEventListener('click', closeStoryModal);
  }

  if (storyModal) {
    storyModal.addEventListener('click', (e) => {
      if (e.target === storyModal) closeStoryModal();
    });
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && storyModal && storyModal.classList.contains('open')) {
      closeStoryModal();
    }
  });


  // =========================================================================
  // 2. HERO SECTION MEDALLION ENGINE (180 DEG SCROLL ROTATION + DUAL COIN + PARTICLES)
  // =========================================================================
  (function initHeroMedallionEngine() {
    const heroTrack = document.getElementById('heroTrack');
    const coinFront = document.getElementById('coinFront');
    const coinBack = document.getElementById('coinBack');
    const apexFlare = document.getElementById('apexLensFlare');
    const laserBg = document.getElementById('laserRibbonBg');
    const laserFg = document.getElementById('laserRibbonFg');
    const chromaticGlow = document.getElementById('heroChromaticGlow');
    const tandemMedallions = document.getElementById('tandemMedallions');
    const heroSection = document.getElementById('hero');
    const particlesCanvas = document.getElementById('medallionParticlesCanvas');

    if (!heroTrack || !coinFront || !coinBack) return;

    const rm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // --- Orbital Canvas Particles ---
    let pCtx = null;
    let particles = [];
    const PARTICLE_COUNT = 44;
    let canvasW = 0, canvasH = 0, centerX = 0, centerY = 0, baseRadius = 150;
    let currentPulse = 0;

    if (particlesCanvas && particlesCanvas.getContext) {
      pCtx = particlesCanvas.getContext('2d');
      function initParticles() {
        const rect = particlesCanvas.getBoundingClientRect();
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvasW = rect.width * dpr;
        canvasH = rect.height * dpr;
        particlesCanvas.width = canvasW;
        particlesCanvas.height = canvasH;
        centerX = canvasW / 2;
        centerY = canvasH / 2;
        baseRadius = Math.min(centerX, centerY) * 0.75;

        particles = [];
        const colors = ['#ff2a3b', '#ffffff', '#ff6075', '#ffa0b0', '#ff1744'];
        for (let i = 0; i < PARTICLE_COUNT; i++) {
          particles.push({
            angle: (i / PARTICLE_COUNT) * Math.PI * 2 + Math.random() * 0.4,
            speed: (0.003 + Math.random() * 0.005) * (Math.random() < 0.5 ? 1 : -1),
            rOffset: (Math.random() - 0.5) * 40 * dpr,
            size: (1.2 + Math.random() * 2) * dpr,
            color: colors[i % colors.length],
            alpha: 0.35 + Math.random() * 0.55,
            tilt: 0.4 + Math.random() * 0.6,
            trail: []
          });
        }
      }
      initParticles();
      window.addEventListener('resize', initParticles, { passive: true });

      function renderParticles() {
        if (!pCtx || canvasW === 0) return;
        pCtx.clearRect(0, 0, canvasW, canvasH);
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        const burstExpansion = currentPulse * 45 * dpr;

        for (let i = 0; i < particles.length; i++) {
          const p = particles[i];
          p.angle += p.speed;
          const effectiveR = baseRadius + p.rOffset + burstExpansion;
          const x = centerX + Math.cos(p.angle) * effectiveR;
          const y = centerY + Math.sin(p.angle) * effectiveR * p.tilt;

          p.trail.push({ x, y });
          if (p.trail.length > 3) p.trail.shift();

          if (p.trail.length > 1) {
            pCtx.beginPath();
            pCtx.moveTo(p.trail[0].x, p.trail[0].y);
            pCtx.lineTo(x, y);
            pCtx.strokeStyle = p.color;
            pCtx.globalAlpha = p.alpha * 0.35;
            pCtx.lineWidth = p.size * 0.7;
            pCtx.stroke();
          }

          pCtx.beginPath();
          pCtx.arc(x, y, p.size * (1 + currentPulse * 0.55), 0, Math.PI * 2);
          pCtx.fillStyle = p.color;
          pCtx.globalAlpha = Math.min(1, p.alpha + currentPulse * 0.4);
          pCtx.fill();
        }

        pCtx.globalAlpha = 1;
        requestAnimationFrame(renderParticles);
      }
      requestAnimationFrame(renderParticles);
    }

    // --- Mouse Parallax Tilt on Hero Section ---
    let ticking = false;
    let mouseTiltX = 0, mouseTiltY = 0;
    let targetTiltX = 0, targetTiltY = 0;

    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches && heroSection) {
      heroSection.addEventListener('mousemove', (e) => {
        if (rm) return;
        const rect = heroSection.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;
        targetTiltX = -y * 5.5; // +/- 2.75 deg
        targetTiltY = x * 6.5;  // +/- 3.25 deg
        if (!ticking) {
          requestAnimationFrame(updateHero);
          ticking = true;
        }
      }, { passive: true });

      heroSection.addEventListener('mouseleave', () => {
        targetTiltX = 0;
        targetTiltY = 0;
        if (!ticking) {
          requestAnimationFrame(updateHero);
          ticking = true;
        }
      });
    }

    function lerp(start, end, factor) {
      return start + (end - start) * factor;
    }

    function updateHero() {
      mouseTiltX = lerp(mouseTiltX, targetTiltX, 0.15);
      mouseTiltY = lerp(mouseTiltY, targetTiltY, 0.15);

      const trackRect = heroTrack.getBoundingClientRect();
      const trackHeight = heroTrack.offsetHeight;
      const viewHeight = window.innerHeight;
      const maxScroll = trackHeight - viewHeight;

      let progress = 0;
      if (maxScroll > 0) {
        const currentScroll = -trackRect.top;
        progress = Math.max(0, Math.min(1, currentScroll / maxScroll));
      }

      const isMobile = window.innerWidth <= 1024;
      const baseSpacing = isMobile ? 48 : 100;

      if (tandemMedallions) {
        tandemMedallions.style.transform = `rotateX(${mouseTiltX.toFixed(2)}deg) rotateY(${mouseTiltY.toFixed(2)}deg)`;
      }

      // FRONT COIN TRANSITIONS:
      const frontAngleY = -26 - progress * 122; // -26deg to -148deg
      const frontX = -baseSpacing * (1 - progress * 0.7);
      const frontZ = (isMobile ? 20 : 55) - progress * 165;
      let frontOpacity = 1;
      if (progress > 0.32) {
        frontOpacity = Math.max(0, 1 - (progress - 0.32) / 0.22);
      }
      coinFront.style.transform = `translateX(${frontX.toFixed(1)}px) translateY(${(4 - progress * 4).toFixed(1)}px) translateZ(${frontZ.toFixed(1)}px) rotateY(${frontAngleY.toFixed(2)}deg) rotateX(${(4 - progress * 4).toFixed(1)}deg)`;
      coinFront.style.opacity = frontOpacity.toFixed(3);
      coinFront.style.pointerEvents = progress > 0.5 ? 'none' : 'auto';

      // BACK COIN TRANSITIONS:
      const backAngleProgress = Math.min(1, progress / 0.7);
      const backAngleY = 22 * (1 - backAngleProgress);
      const backXProgress = Math.min(1, progress / 0.65);
      const backX = baseSpacing * (1 - backXProgress);
      const backZ = (isMobile ? -20 : -55) + progress * 115;
      const backScale = (isMobile ? 0.92 : 0.94) + progress * 0.18;
      coinBack.style.transform = `translateX(${backX.toFixed(1)}px) translateY(${(-6 + progress * 6).toFixed(1)}px) translateZ(${backZ.toFixed(1)}px) rotateY(${backAngleY.toFixed(2)}deg) rotateX(${(2 - progress * 2).toFixed(1)}deg) scale(${backScale.toFixed(3)})`;
      coinBack.style.zIndex = progress > 0.38 ? '6' : '3';

      // APEX LENS FLARE PULSE (peaking at crossover p ~ 0.5)
      const distFromCrossover = Math.abs(progress - 0.5);
      let crossoverPulse = 0;
      if (distFromCrossover < 0.18) {
        crossoverPulse = Math.cos((distFromCrossover / 0.18) * (Math.PI / 2));
      }
      currentPulse = crossoverPulse;

      if (apexFlare) {
        const flareX = backX * 0.5;
        const flareScale = 0.9 + crossoverPulse * 0.95;
        const flareOpacity = 0.75 + crossoverPulse * 0.25;
        apexFlare.style.transform = `translate(calc(-50% + ${flareX.toFixed(1)}px), -50%) translateZ(${(48 + crossoverPulse * 20).toFixed(1)}px) scale(${flareScale.toFixed(3)})`;
        apexFlare.style.opacity = flareOpacity.toFixed(3);
      }

      if (chromaticGlow) {
        chromaticGlow.style.opacity = (crossoverPulse * 0.75).toFixed(3);
      }

      if (laserFg) {
        laserFg.style.opacity = (0.9 - progress * 0.2 + crossoverPulse * 0.3).toFixed(3);
        laserFg.style.transform = `translateZ(${(42 + crossoverPulse * 15).toFixed(1)}px) scale(${(1 + progress * 0.08).toFixed(3)})`;
      }
      if (laserBg) {
        laserBg.style.opacity = (0.5 + progress * 0.3).toFixed(3);
      }

      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(updateHero);
        ticking = true;
      }
    }, { passive: true });

    window.addEventListener('resize', () => {
      if (!ticking) {
        requestAnimationFrame(updateHero);
        ticking = true;
      }
    }, { passive: true });

    updateHero();
  })();



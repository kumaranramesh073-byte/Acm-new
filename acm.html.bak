      desc: "Coordinating venue staging, audio-visual technical setups, schedule precision, and attendee operations.",
      photo: "public/team/rashmika_s.jpg?v=acm2026",
      video: "public/videos/team/Rashmika.mp4",
      framesDir: "public/frames/team/rashmika_s",
      frameCount: 60,
      posOffsetY: 0.15
    },
    {
      id: "member-17",
      slug: "nura_majumder",
      name: "Nura Majumder",
      role: "Lead \u2014 Public Relations & Partnerships",
      team: "Management Team",
      committee: "Management Division",
      department: "Dept. of Computer Science & Engineering",
      year: "IV Year",
      desc: "Managing external sponsor liaisons, guest speaker invitations, institutional partnerships, and PR campaigns.",
      photo: "public/team/nura_majumder.jpg?v=acm2026",
      video: "public/videos/team/Nura.mp4",
      framesDir: "public/frames/team/nura_majumder",
      frameCount: 60,
      posOffsetY: 0.15
    }
  ];

  class CinematicScrollEngine {
    constructor(config) {
      this.config = config || [];
      this.total = this.config.length;
      if (!this.total) return;

      this.currentMemberIdx = 0;
      this.currentFrameIdx = 0;
      this.currentLocalProg = 0;
      this.lastRenderedMember = -1;
      this.lastRenderedFrame = -1;
      this.frameCache = new Map();
      this.loadingMembers = new Set();
      this.reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      this.track = document.getElementById('teamCinemaTrack');
      if (!this.track) return;
      this.track.style.height = `${this.total * 80}vh`;

      this.canvas = document.getElementById('teamVideoCanvas');
      this.ctx = this.canvas ? this.canvas.getContext('2d') : null;
      this.ambientCanvas = document.getElementById('teamAmbientCanvas');
      this.ambientCtx = this.ambientCanvas ? this.ambientCanvas.getContext('2d') : null;
      this.fallbackImg = document.getElementById('teamFallbackImg');
      this.videoEl = document.getElementById('teamVideoElement');

      this.infoPanel = document.getElementById('cinemaInfoPanel');
      this.badgeEl = document.getElementById('cinemaCommittee');
      this.nameEl = document.getElementById('cinemaName');
      this.roleEl = document.getElementById('cinemaRole');
      this.subEl = document.getElementById('cinemaSub');
      this.descEl = document.getElementById('cinemaDesc');
      this.counterEl = document.getElementById('cinemaCounter');

      this.railDots = document.getElementById('cinemaRailDots');
      this.prevBtn = document.getElementById('cinemaPrevBtn');
      this.nextBtn = document.getElementById('cinemaNextBtn');
      this.autoPlayBtn = document.getElementById('cinemaAutoPlayBtn');

      this.isAutoPlaying = false;
      this.autoPlayProgress = 0;
      this.autoPlayRaf = null;

      this.initDots();
      this.resizeCanvas();
      window.addEventListener('resize', () => this.resizeCanvas());

      this.ticking = false;
      window.addEventListener('scroll', () => this.requestTick(), { passive: true });

      this.bindEvents();
      this.preloadMemberFrames(0);
      this.preloadMemberFrames(1);
      this.render();
    }

    initDots() {
      if (!this.railDots) return;
      this.railDots.innerHTML = '';
      this.dots = [];
      this.config.forEach((m, idx) => {
        const dot = document.createElement('button');
        dot.className = `cinema-rail-dot ${idx === 0 ? 'active' : ''}`;
        dot.setAttribute('aria-label', `Navigate to ${m.name}`);
        dot.setAttribute('title', `${m.name} (${m.role})`);
        dot.addEventListener('click', () => this.scrollToMember(idx));
        this.railDots.appendChild(dot);
        this.dots.push(dot);
      });
    }

    scrollToMember(idx) {
      if (!this.track) return;
      const rect = this.track.getBoundingClientRect();
      const scrollDist = this.track.offsetHeight - window.innerHeight;
      const targetP = (idx + 0.3) / this.total;
      const targetScroll = window.scrollY + rect.top + targetP * scrollDist;
      window.scrollTo({ top: targetScroll, behavior: 'smooth' });
    }

    resizeCanvas() {
      if (!this.canvas) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const rect = this.canvas.getBoundingClientRect();
      if (rect.width > 0 && rect.height > 0) {
        this.canvas.width = rect.width * dpr;
        this.canvas.height = rect.height * dpr;
      }
      this.renderCanvasFrame(this.currentMemberIdx, this.currentFrameIdx);
    }

    preloadMemberFrames(memberIdx) {
      if (memberIdx < 0 || memberIdx >= this.total) return;
      if (this.loadingMembers.has(memberIdx)) return;
      this.loadingMembers.add(memberIdx);

      const m = this.config[memberIdx];
      const count = m.frameCount || 60;
      const step = 2; // Preload alternate frames for fast smooth scrubbing

      for (let f = 1; f <= count; f += step) {
        const padF = String(f).padStart(3, '0');
        const src = `${m.framesDir}/frame_${padF}.jpg`;
        const key = `${m.slug}_${f}`;
        if (!this.frameCache.has(key)) {
          const img = new Image();
          img.src = src;
          img.onload = () => {
            this.frameCache.set(key, img);
            if (this.currentMemberIdx === memberIdx) {
              this.renderCanvasFrame(this.currentMemberIdx, this.currentFrameIdx);
            }
          };
        }
      }
    }

    bindEvents() {
      if (this.prevBtn) {
        this.prevBtn.addEventListener('click', () => {
          this.scrollToMember(Math.max(0, this.currentMemberIdx - 1));
        });
      }
      if (this.nextBtn) {
        this.nextBtn.addEventListener('click', () => {
          this.scrollToMember(Math.min(this.total - 1, this.currentMemberIdx + 1));
        });
      }
      if (this.autoPlayBtn) {
        this.autoPlayBtn.addEventListener('click', () => this.toggleAutoPlay());
      }
    }

    toggleAutoPlay() {
      if (this.isAutoPlaying) {
        this.stopAutoPlay();
      } else {
        this.startAutoPlay();
      }
    }

    startAutoPlay() {
      this.isAutoPlaying = true;
      if (this.autoPlayBtn) {
        this.autoPlayBtn.classList.add('playing');
        this.autoPlayBtn.innerHTML = '<span>&#10074;&#10074;</span> <span>Pause</span>';
      }
      let lastTime = performance.now();
      const loop = (time) => {
        if (!this.isAutoPlaying) return;
        const dt = (time - lastTime) / 1000;
        lastTime = time;

        const rect = this.track.getBoundingClientRect();
        const scrollDist = this.track.offsetHeight - window.innerHeight;
        const currentP = Math.max(0, Math.min(1, -rect.top / scrollDist));

        let newP = currentP + dt * 0.08;
        if (newP >= 1) newP = 0;

        const targetScroll = window.scrollY + rect.top + newP * scrollDist;
        window.scrollTo({ top: targetScroll, behavior: 'auto' });

        this.autoPlayRaf = requestAnimationFrame(loop);
      };
      this.autoPlayRaf = requestAnimationFrame(loop);
    }

    stopAutoPlay() {
      this.isAutoPlaying = false;
      if (this.autoPlayRaf) cancelAnimationFrame(this.autoPlayRaf);
      if (this.autoPlayBtn) {
        this.autoPlayBtn.classList.remove('playing');
        this.autoPlayBtn.innerHTML = '<span>&#9654;</span> <span>Auto Tour</span>';
      }
    }

    requestTick() {
      if (!this.ticking) {
        requestAnimationFrame(() => {
          this.render();
          this.ticking = false;
        });
        this.ticking = true;
      }
    }

    render() {
      if (!this.track) return;
      const rect = this.track.getBoundingClientRect();
      const scrollDist = this.track.offsetHeight - window.innerHeight;
      if (scrollDist <= 0) return;

      const p = Math.max(0, Math.min(0.9999, -rect.top / scrollDist));
      const scaled = p * this.total;
      const mIdx = Math.floor(scaled);
      const localProg = scaled - mIdx;

      this.currentMemberIdx = mIdx;
      this.currentLocalProg = localProg;

      const m = this.config[mIdx];
      const count = m.frameCount || 60;
      const fIdx = Math.min(count, Math.max(1, Math.floor(localProg * count) + 1));
      this.currentFrameIdx = fIdx;

      // Update Info Panel
      if (this.lastRenderedMember !== mIdx) {
        this.updateInfoPanel(m, mIdx);
        this.preloadMemberFrames(mIdx);
        this.preloadMemberFrames(mIdx + 1);
        this.lastRenderedMember = mIdx;
      }

      this.renderCanvasFrame(mIdx, fIdx);
    }

    updateInfoPanel(m, idx) {
      if (this.badgeEl) this.badgeEl.textContent = m.committee || m.team;
      if (this.nameEl) this.nameEl.textContent = m.name;
      if (this.roleEl) this.roleEl.textContent = m.role;
      if (this.subEl) {
        this.subEl.innerHTML = `<span>${m.department}</span> \u2022 <span>${m.year}</span>`;
      }
      if (this.descEl) this.descEl.textContent = m.desc;
      if (this.counterEl) {
        this.counterEl.textContent = `${String(idx + 1).padStart(2, '0')} / ${String(this.total).padStart(2, '0')}`;
      }
      if (this.fallbackImg && m.photo) {
        this.fallbackImg.src = m.photo;
      }
      if (this.dots) {
        this.dots.forEach((dot, i) => {
          dot.classList.toggle('active', i === idx);
        });
      }
    }

    renderCanvasFrame(mIdx, fIdx) {
      const m = this.config[mIdx];
      if (!m) return;

      const cw = this.canvas ? this.canvas.width : 0;
      const ch = this.canvas ? this.canvas.height : 0;

      // Draw subtle ambient glow on ambientCanvas
      if (this.ambientCtx) {
        const actx = this.ambientCtx;
        actx.clearRect(0, 0, 128, 128);
        const grad = actx.createRadialGradient(64, 64, 10, 64, 64, 64);
        grad.addColorStop(0, 'rgba(255, 42, 59, 0.45)');
        grad.addColorStop(0.6, 'rgba(168, 15, 27, 0.2)');
        grad.addColorStop(1, 'rgba(0, 0, 0, 0)');
        actx.fillStyle = grad;
        actx.fillRect(0, 0, 128, 128);
      }

      const key = `${m.slug}_${fIdx}`;
      const frameImg = this.frameCache.get(key);

      if (frameImg && frameImg.complete && frameImg.naturalWidth > 0) {
        if (this.fallbackImg) this.fallbackImg.style.opacity = '0';
        if (this.videoEl) this.videoEl.style.opacity = '0';

        if (this.ctx) {
          this.ctx.clearRect(0, 0, cw, ch);
          const imgW = frameImg.naturalWidth;
          const imgH = frameImg.naturalHeight;
          const scale = Math.max(cw / imgW, ch / imgH);
          const drawW = imgW * scale;
          const drawH = imgH * scale;
          const drawX = (cw - drawW) / 2;
          const offsetY = (m.posOffsetY !== undefined) ? m.posOffsetY : 0.15;
          const drawY = (ch - drawH) * offsetY;
          this.ctx.drawImage(frameImg, drawX, drawY, drawW, drawH);
        }
      } else {
        // Fallback: show photo or seek HTML5 video if available
        if (this.fallbackImg) this.fallbackImg.style.opacity = '1';

        if (this.videoEl && this.videoEl.duration) {
          if (!this.videoEl.seeking) {
            this.videoEl.currentTime = this.currentLocalProg * this.videoEl.duration;
            this.videoEl.style.opacity = '1';
            if (this.fallbackImg) this.fallbackImg.style.opacity = '0';
          }
        }
      }
    }
  }


  // =========================================================================
  // 4. 3D LAPTOP CRT SCREEN OPENING & FIVE TEAMS VOLUMETRIC RAYS ENGINE
  // =========================================================================
  (function initLaptopCrtTeamsEngine() {
    const teamsTrack = document.getElementById('teamsTrack');
    const laptopLid = document.getElementById('laptopLid');
    const screenCoreLight = document.getElementById('screenCoreLight');
    const screenGlowEmblem = document.getElementById('screenGlowEmblem');
    const screenTerminalText = document.getElementById('screenTerminalText');
    const laptopStage = document.getElementById('laptopStage');

    const rays = [
      document.getElementById('ray1'),
      document.getElementById('ray2'),
      document.getElementById('ray3'),
      document.getElementById('ray4'),
      document.getElementById('ray5')
    ];

    const panels = [
      document.getElementById('teamPanel1'),
      document.getElementById('teamPanel2'),
      document.getElementById('teamPanel3'),
      document.getElementById('teamPanel4'),
      document.getElementById('teamPanel5')
    ];

    if (!teamsTrack || !laptopLid) return;

    let ticking = false;

    // Mouse tilt on laptop stage
    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches && laptopStage) {
      window.addEventListener('mousemove', (e) => {
        const rect = laptopStage.getBoundingClientRect();
        if (rect.top < window.innerHeight && rect.bottom > 0) {
          const x = (e.clientX - (rect.left + rect.width / 2)) / (window.innerWidth / 2);
          const y = (e.clientY - (rect.top + rect.height / 2)) / (window.innerHeight / 2);
          laptopStage.style.transform = `rotateX(${(12 - y * 4).toFixed(1)}deg) rotateY(${(x * 6).toFixed(1)}deg)`;
        }
      }, { passive: true });
    }

    function updateTeamsScroll() {
      const rect = teamsTrack.getBoundingClientRect();
      const trackHeight = teamsTrack.offsetHeight;
      const viewHeight = window.innerHeight;
      const maxScroll = trackHeight - viewHeight;

      let progress = 0;
      if (maxScroll > 0) {
        progress = Math.max(0, Math.min(1, -rect.top / maxScroll));
      }

      const isMobile = window.innerWidth <= 1024;

      // Phase 1: Laptop Lid Opening (p = 0 to 0.35)
      // Lid starts closed flat on base (75deg) and opens upright around rear hinge (-10deg)
      const openProg = Math.min(1, Math.max(0, progress / 0.35));
      const lidAngle = 75 - openProg * 85; // 75deg -> -10deg
      laptopLid.style.transform = `rotateX(${lidAngle.toFixed(2)}deg)`;

      // Phase 2: CRT Screen Power-Up Bloom & Terminal Status (p = 0.15 to 0.38)
      const crtProg = Math.min(1, Math.max(0, (progress - 0.15) / 0.23));
      if (screenCoreLight) {
        screenCoreLight.style.opacity = (crtProg * 0.95).toFixed(3);
      }
      if (screenGlowEmblem) {
        screenGlowEmblem.style.opacity = crtProg.toFixed(3);
        screenGlowEmblem.style.transform = `scale(${(0.85 + crtProg * 0.15).toFixed(2)})`;
      }
      if (screenTerminalText) {
        screenTerminalText.style.opacity = crtProg.toFixed(3);
        screenTerminalText.style.transform = `scale(${(0.9 + crtProg * 0.1).toFixed(2)})`;
      }

      // Phase 3 & 4: Five Volumetric Light Rays & Team Panels Reveal (p = 0.28 to 0.65)
      rays.forEach((ray, i) => {
        if (!ray) return;
        if (isMobile) {
          ray.style.opacity = '0';
          return;
        }
        const startP = 0.26 + i * 0.05;
        const endP = startP + 0.16;
        const rayProg = Math.min(1, Math.max(0, (progress - startP) / (endP - startP)));
        const offset = 600 * (1 - rayProg);
        ray.style.strokeDashoffset = offset.toFixed(1);
        ray.style.opacity = (rayProg * 0.95).toFixed(3);
      });

      panels.forEach((panel, i) => {
        if (!panel) return;
        if (isMobile) {
          panel.style.opacity = '1';
          panel.style.transform = 'none';
          return;
        }
        const startP = 0.28 + i * 0.06;
        const endP = startP + 0.15;
        const panelProg = Math.min(1, Math.max(0, (progress - startP) / (endP - startP)));
        const translateY = 45 * (1 - panelProg);
        const scale = 0.88 + panelProg * 0.12;
        panel.style.opacity = panelProg.toFixed(3);
        panel.style.transform = `translateY(${translateY.toFixed(1)}px) scale(${scale.toFixed(3)})`;
        if (panelProg > 0.75) {
          panel.style.borderColor = 'rgba(255, 42, 59, 0.45)';
          panel.style.boxShadow = '0 20px 50px rgba(0,0,0,0.85), 0 0 25px rgba(255,42,59,0.2)';
        } else {
          panel.style.borderColor = 'var(--line-light)';
          panel.style.boxShadow = '0 16px 45px rgba(0,0,0,0.7)';
        }
      });

      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(updateTeamsScroll);
        ticking = true;
      }
    }, { passive: true });

    window.addEventListener('resize', () => {
      if (!ticking) {
        requestAnimationFrame(updateTeamsScroll);
        ticking = true;
      }
    }, { passive: true });

    updateTeamsScroll();
  })();


  // =========================================================================
  // 5. SITE NETWORK BACKGROUND PARTICLES ENGINE
  // =========================================================================
  function initSiteNetwork() {
    const canvas = document.getElementById('siteNetworkCanvas');
    if (!canvas || !canvas.getContext) return;
    const ctx = canvas.getContext('2d');
    const rm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (rm) return;

    let w = 0, h = 0;
    let nodes = [];
    const count = Math.min(38, Math.floor(window.innerWidth / 35));

    function resize() {
      w = canvas.width = window.innerWidth;
      h = canvas.height = window.innerHeight;
      nodes = Array.from({ length: count }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        vx: (Math.random() - 0.5) * 0.32,
        vy: (Math.random() - 0.5) * 0.32,
        r: 1.2 + Math.random() * 1.6
      }));
    }
    resize();
    window.addEventListener('resize', resize, { passive: true });

    let mouse = { x: -999, y: -999 };
    window.addEventListener('mousemove', e => {
      mouse.x = e.clientX;
      mouse.y = e.clientY;
    }, { passive: true });
    window.addEventListener('mouseleave', () => {
      mouse.x = -999;
      mouse.y = -999;
    });

    function draw() {
      requestAnimationFrame(draw);
      ctx.clearRect(0, 0, w, h);

      const pri = '#ff2a3b';
      ctx.fillStyle = pri;
      ctx.strokeStyle = pri;

      for (let i = 0; i < nodes.length; i++) {
        const a = nodes[i];
        a.x += a.vx;
        a.y += a.vy;
        if (a.x < 0) a.x = w;
        if (a.x > w) a.x = 0;
        if (a.y < 0) a.y = h;
        if (a.y > h) a.y = 0;

        const mdx = a.x - mouse.x;
        const mdy = a.y - mouse.y;
        const md = Math.hypot(mdx, mdy);
        if (md < 110 && md > 0) {
          a.x += (mdx / md) * 1.1;
          a.y += (mdy / md) * 1.1;
        }

        ctx.globalAlpha = 0.5;
        ctx.beginPath();
        ctx.arc(a.x, a.y, a.r, 0, Math.PI * 2);
        ctx.fill();

        for (let j = i + 1; j < nodes.length; j++) {
          const b = nodes[j];
          const dist = Math.hypot(a.x - b.x, a.y - b.y);
          if (dist < 125) {
            ctx.globalAlpha = (1 - dist / 125) * 0.22;
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.stroke();
          }
        }
      }
    }
    draw();
  }


  // =========================================================================
  // 6. INITIALIZATION ON DOM READY
  // =========================================================================
  function initMobileDrawer() {
    const menuToggle = document.getElementById('menuToggle');
    const mobileDrawer = document.getElementById('mobileNavDrawer');
    if (menuToggle && mobileDrawer) {
      menuToggle.addEventListener('click', (e) => {
        e.stopPropagation();
        mobileDrawer.classList.toggle('open');
      });
      mobileDrawer.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          mobileDrawer.classList.remove('open');
        });
      });
      document.addEventListener('click', (e) => {
        if (!mobileDrawer.contains(e.target) && e.target !== menuToggle) {
          mobileDrawer.classList.remove('open');
        }
      });
    }
  }

  function initAll() {
    window.cinematicTeamEngine = new CinematicScrollEngine(window.ACM_TEAM_CONFIG);
    initSiteNetwork();
    initMobileDrawer();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }

})();
</script>
</body>
</html>
